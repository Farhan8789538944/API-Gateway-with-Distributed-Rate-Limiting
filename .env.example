# Copy to .env (PowerShell:  Copy-Item .env.example .env) and change the passwords.
# These are local development values only. Never put real credentials in this file.

# PostgreSQL superuser used ONLY by the one-shot `setup` service and the admin CLI.
POSTGRES_USER=apigw_admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=apigw

# Least-privilege application roles (created by the migrations, passwords set by setup).
GATEWAY_DB_PASSWORD=change-me-gateway
CATALOG_DB_PASSWORD=change-me-catalog
ORDERS_DB_PASSWORD=change-me-orders

# Localhost port that Nginx (the only public entry point) is published on.
GATEWAY_HTTP_PORT=8080

# Log level for all application services.
LOG_LEVEL=INFO

# Development-only response headers (X-Gateway-Instance, X-Upstream-Instance, X-Instance-Id).
EXPOSE_INSTANCE_HEADERS=true
